        "weight": "bold"
      },
      "h3": {
        "size": 24,
        "lineHeight": 1.4,
        "weight": "bold"
      },
      "body": {
        "size": 16,
        "lineHeight": 1.6,
        "weight": "normal"
      },
      "caption": {
        "size": 14,
        "lineHeight": 1.5,
        "weight": "normal"
      },
      "small": {
        "size": 12,
        "lineHeight": 1.4,
        "weight": "normal"
      }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
