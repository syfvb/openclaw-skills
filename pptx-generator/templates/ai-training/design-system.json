{
  "name": "豆包AI培训深色科技模板",
  "version": "1.0",
  "source": "template.pptx",
  "colors": {
    "background": {
      "primary": "#1a1d29",
      "secondary": "#161922",
      "card": "#1e2230",
      "elevated": "#252a3c"
    },
    "primary": {
      "main": "#3b82f6",
      "light": "#60a5fa",
      "dark": "#1d4ed8"
    },
    "accent": {
      "red": "#ef4444",
      "green": "#10b981",
      "orange": "#f59e0b",
      "purple": "#8b5cf6"
    },
    "text": {
      "primary": "#ffffff",
      "secondary": "#94a3b8",
      "muted": "#64748b",
      "disabled": "#475569"
    },
    "border": {
      "light": "#334155",
      "DEFAULT": "#1e293b",
      "dark": "#0f172a"
